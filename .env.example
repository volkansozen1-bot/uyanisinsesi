# Bu dosyayi .env adiyla kopyalayin ve kendi bilgilerinizle doldurun.
# .env dosyasi repoya gonderilmez.

# Bos birakilirsa adres otomatik bulunur (yerel gelistirme icin yeterli).
# Canli sitede mutlaka yazin, ornek: APP_URL=https://www.alanadiniz.com
APP_URL=
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uyanisinsesi
DB_USER=root
DB_PASS=

# E-posta (SMTP). MAIL_HOST bos birakilirsa e-posta gonderilmez,
# icerik storage/logs/mail.log dosyasina yazilir (yerel gelistirme icin).
# Port 465: SSL (SMTPS), 587: STARTTLS. Ornekler:
#   Hosting SMTP : MAIL_HOST=mail.alanadiniz.com  MAIL_PORT=587 (ya da 465), kullanici = e-posta adresi
#   Yandex       : MAIL_HOST=smtp.yandex.com.tr   MAIL_PORT=465
#   Gmail        : MAIL_HOST=smtp.gmail.com       MAIL_PORT=587, MAIL_PASS = Google "uygulama sifresi"
#                  (normal Gmail sifresi calismaz; hesapta 2 adimli dogrulama acik olmali)
# MAIL_FROM genelde MAIL_USER ile ayni adres olmali, yoksa sunucu reddedebilir.
# MAIL_FROM_NAME bos ise site adi (Ayarlar > site_name) kullanilir.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=
