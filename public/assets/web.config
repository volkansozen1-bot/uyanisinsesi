<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS: .webp gorselleri sunulsun (eski IIS surumlerinde bu tur tanimli degil) -->
<configuration>
    <system.webServer>
        <staticContent>
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
        </staticContent>
    </system.webServer>
</configuration>
